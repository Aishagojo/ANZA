node_modules/

# Local environment configuration and secrets
.env
.env.*
!.env.example

# Private key and wallet files
*.key
*.pem
*.p12
*.pfx
*.crt
*.secret
secrets/
wallets/

# Local data, database exports, and uploaded media
data/
storage/
uploads/
*.sql
*.dump
*.backup

# ...but schema migrations are source code, not data. They must be committed
# or a fresh checkout cannot build the database.
!src/database/migrations/*.sql

# Test output, logs, and runtime files
coverage/
logs/
*.log
*.pid
.cache/
.tmp/
